rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // تأمين وحماية قاعدة بيانات الكنيسة والخدمة من التخريب أو التلاعب
    match /church_db/{docId} {
      // السماح بالقراءة فقط لمستند البيانات الرئيسي main_data
      // ملاحظة أمنية هامة: عند تفعيل Firebase Authentication، يُوصى بتغيير الشرط إلى:
      // allow read, write: if request.auth != null;
      allow read: if docId == 'main_data';

      // السماح بالإنشاء فقط لمستند main_data بشرط مطابقة البنية الأساسية
      allow create: if docId == 'main_data' &&
                    request.resource.data.members is list &&
                    request.resource.data.attendance is map &&
                    request.resource.data.visitations is map;

      // السماح بالتحديث بشرط الحفاظ على الهيكل ومنع مسح البيانات الأساسية
      allow update: if docId == 'main_data' &&
                    request.resource.data.members is list &&
                    request.resource.data.attendance is map &&
                    request.resource.data.visitations is map &&
                    (!('trips' in request.resource.data) || request.resource.data.trips is list) &&
                    (!('servantNotes' in request.resource.data) || request.resource.data.servantNotes is list) &&
                    // منع تفريغ أو تصفير الأعضاء إذا كانت القاعدة تحتوي على بيانات بالفعل
                    (resource.data.members.size() == 0 || request.resource.data.members.size() > 0);

      // منع المسح الكلي للمستند منعاً باتاً
      allow delete: if false;
    }

    // إغلاق أي وصول لأي وثائق أخرى خارج church_db
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
